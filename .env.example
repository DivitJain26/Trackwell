# Copy this file to .env and adjust values if required.
# All values are optional; sensible local defaults are used when unset.

# Secret key used to sign session cookies. If omitted a random key is
# generated once and stored in instance/secret_key.
# TRACKWELL_SECRET_KEY=replace-with-a-long-random-string

# Where the SQLite database, model artifacts, uploads and logs are stored.
# TRACKWELL_INSTANCE_PATH=./instance

# Host/port for the local development server.
# TRACKWELL_HOST=127.0.0.1
# TRACKWELL_PORT=5000

# Set to 1 only when running behind HTTPS (enables Secure cookies).
# TRACKWELL_HTTPS=0

# Set to 1 for Flask debug mode (development only, never for shared use).
# FLASK_DEBUG=0
